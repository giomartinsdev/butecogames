# MongoDB
MONGODB_URI=mongodb://localhost:27017/butecogames

# Better Auth
BETTER_AUTH_SECRET=  # Generate with: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3001

# Discord OAuth2 (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=  # Discord server ID to restrict access to

# Server
PORT=3001
NODE_ENV=development

# Cloudflare R2 (image storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=butecogames-images
R2_PUBLIC_URL=https://images.butecodosdevs.com

# Client
VITE_API_URL=http://localhost:3001
VITE_WS_URL=http://localhost:3001
